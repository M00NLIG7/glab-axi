  "backend": "official-glab 1.112.0 (816e3a52)",
  "envelope": "glab-axi/ux-v1",
  "differences": [
    "Open is the sole public spelling for open list state; GitLab opened remains the returned state. Closed excludes merged MRs; merged has its own selector.",
    "Labels are repeated exact AND filters. CSV, duplicate labels and provider selector keywords are rejected. Author/assignee require explicit usernames, not @me.",
    "Issue sort supports created and updated descending, not GitHub comment count. MR branches use source-branch and target-branch.",
    "List fields adds declared optional GitLab fields, retaining all default fields. Views do not accept fields. Omission preserves existing defaults.",
    "Description is opt-in on lists and on by default in views with a fixed 131072-byte cap. The reference view --full option is not implemented; oversized bodies remain truncated.",
    "Milestone/closed/merged timestamp enrichment, issue comments and MR approvals are not delivered here. Existing MR discussions remain a separate shipped read.",
    "Native glab-axi/v1 and its argv/schema contract are unchanged."
  ],
  "capabilities": [
    {"name":"issue state","reference":"issue list --state closed","classification":"equivalent","argv":["issue","list","--state=closed"],"exit":0,"upstream":"issue list --output json --closed --page 1 --per-page 31 -R group/project"},
    {"name":"MR state","reference":"pr list --state closed","classification":"gitlab-native-equivalent","argv":["mr","list","--state=closed"],"exit":0,"upstream":"mr list --output json --closed --page 1 --per-page 31 -R group/project"},
    {"name":"AND labels","reference":"issue list --label triage --label needs-review","classification":"equivalent","argv":["issue","list","--label=triage","--label=needs-review"],"exit":0,"upstream":"issue list --output json --label=triage --label=needs-review --page 1 --per-page 31 -R group/project"},
    {"name":"author and assignee","reference":"pr list --author alice --assignee bob","classification":"equivalent","argv":["mr","list","--author=alice","--assignee=bob"],"exit":0,"upstream":"mr list --output json --author=alice --assignee=bob --page 1 --per-page 31 -R group/project"},
    {"name":"issue milestone","reference":"issue list --milestone release-2","classification":"equivalent","argv":["issue","list","--milestone=release-2"],"exit":0,"upstream":"issue list --output json --milestone=release-2 --page 1 --per-page 31 -R group/project"},
    {"name":"issue order","reference":"issue list --sort updated","classification":"equivalent","argv":["issue","list","--sort=updated"],"exit":0,"upstream":"issue list --output json --order=updated_at --sort=desc --page 1 --per-page 31 -R group/project"},
    {"name":"comment-count order","reference":"issue list --sort comments","classification":"implementable-gap","argv":["issue","list","--sort=comments"],"exit":2},
    {"name":"MR branches","reference":"pr list --base main --head feature/topic","classification":"gitlab-native-equivalent","argv":["mr","list","--target-branch=main","--source-branch=feature/topic"],"exit":0,"upstream":"mr list --output json --source-branch=feature/topic --target-branch=main --page 1 --per-page 31 -R group/project"},
    {"name":"draft selection","reference":"pr list --draft","classification":"equivalent","argv":["mr","list","--draft"],"exit":0,"upstream":"mr list --output json --draft --page 1 --per-page 31 -R group/project"},
    {"name":"bounded list body","reference":"issue list --fields body","classification":"gitlab-native-equivalent","argv":["issue","list","--fields=description"],"exit":0,"upstream":"issue list --output json --page 1 --per-page 31 -R group/project"},
    {"name":"bounded view body","reference":"pr view 42","classification":"gitlab-native-equivalent","argv":["mr","view","42"],"exit":0,"upstream":"mr view 42 --output json -R group/project"},
    {"name":"full view body","reference":"pr view 42 --full","classification":"implementable-gap","argv":["mr","view","42","--full"],"exit":2},
    {"name":"milestone enrichment","reference":"issue list --fields milestone","classification":"implementable-gap","argv":["issue","list","--fields=milestone"],"exit":2}
  ],
