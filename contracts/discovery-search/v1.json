  ],
  "routes": [
    {"operation": "repo-discovery", "method": "GET", "path": "projects", "query": ["page", "per_page", "visibility", "archived", "with_programming_language", "search", "order_by", "sort"]},
    {"operation": "repo-discovery", "method": "GET", "path": "users/{username}/projects", "query": ["page", "per_page", "visibility", "archived", "with_programming_language", "search", "order_by", "sort"]},
    {"operation": "repo-discovery", "method": "GET", "path": "groups/{escaped_full_path}/projects", "query": ["page", "per_page", "visibility", "archived", "search", "order_by", "sort", "with_shared=false", "include_subgroups"]},
    {"operation": "discovery-group", "method": "GET", "path": "groups/{escaped_full_path}", "query": ["with_projects=false"]},
    {"operation": "discovery-project", "method": "GET", "path": "projects/{escaped_repo_or_positive_id}", "query": []},
    {"operation": "search", "method": "GET", "path": "search", "query": ["scope=projects|issues|merge_requests", "search", "page", "per_page", "state", "order_by=created_at", "sort=desc"]},
    {"operation": "search", "method": "GET", "path": "groups/{escaped_full_path}/search", "query": ["scope=projects|issues|merge_requests", "search", "page", "per_page", "state", "order_by=created_at", "sort=desc"]},
    {"operation": "search", "method": "GET", "path": "projects/{escaped_repo}/search", "query": ["scope=issues|merge_requests|commits|blobs", "search", "page", "per_page", "state", "order_by=created_at", "sort=desc"]}
  ],
  "fields": {
    "repository": ["id", "name", "path_with_namespace", "web_url", "namespace.kind", "namespace.full_path", "namespace.id", "visibility", "archived", "http_url_to_repo", "ssh_url_to_repo"],
    "group": ["id", "full_path", "web_url"],
    "search": ["id", "iid", "project_id", "web_url", "path_with_namespace", "state"]
  },
  "selectors": {
    "repo list": ["--owner USER (or positional USER)", "--group FULL_PATH", "--include-subgroups", "--visibility public|internal|private", "--archived", "--active", "--language LANGUAGE (host/user only)", "--fields clone_urls"],
    "repo view": ["--fields clone_urls"],
    "search issues": ["--scope project|host", "--group FULL_PATH", "--state opened|closed|all", "--sort created"],
    "search mrs": ["--scope project|host", "--group FULL_PATH", "--state opened|closed|merged|all", "--sort created"],
    "search repos": ["--group FULL_PATH", "--owner USER", "--language LANGUAGE (host/user only)", "--sort created"],
    "search commits": [],
    "search code": []
  },
  "residuals": [
    "GitHub owner is ambiguous between user and organization; explicit user --owner and GitLab --group are distinct",
    "GitLab language means uses programming language, not GitHub primary language; unavailable for group discovery",
    "Search labels, assignee, author, draft, review and arbitrary sort are not supported by the pinned search routes; never encoded as guessed query qualifiers",
    "GitHub stars comparisons and code language have no faithful mapping in this slice",
    "Commit author login and author-date/committer-date sorting have no faithful search mapping in this slice",
    "Host/group code and commit search require advanced-search/tier and per-result identity contracts not exposed in this slice",
    "No filter-only search or arbitrary GitHub qualifier parser is added; the existing query remains GitLab-native search text",
    "Clone URLs are optional identity metadata only; SSH alternate hosts/users/ports and insecure HTTP are refused, never cloned"
  ]
}
