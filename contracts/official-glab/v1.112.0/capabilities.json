{
  "schema": "glab-axi/official-glab-contract/v1",
  "release": {
    "version": "1.112.0",
    "tag": "v1.112.0",
    "tag_object": "a274f4c12f1ab92b155f09d2e0a9e106bcebb248",
    "source_commit": "816e3a52411aba73d90237859fdc6ecbc86bd169",
    "source_url": "https://gitlab.com/gitlab-org/cli/-/tree/v1.112.0",
    "darwin_arm64_url": "https://gitlab.com/gitlab-org/cli/-/releases/v1.112.0/downloads/glab_1.112.0_darwin_arm64.tar.gz",
    "darwin_arm64_sha256": "07f980f76cf11d32d946bb2f47d220ac5bc4bb5df136b0289df4325390034704",
    "linux_amd64_url": "https://gitlab.com/gitlab-org/cli/-/releases/v1.112.0/downloads/glab_1.112.0_linux_amd64.tar.gz",
    "linux_amd64_sha256": "f1c52907558b665f2032b615787d353cd06e54240b501a81f9489bfc8f6a8ebf",
    "version_output": "glab 1.112.0 (816e3a52)",
    "license": "MIT"
  },
  "evidence": {
    "help_sha256": "6c3ce8f7a13d4986888a421a74e6d1afd4037874bcdad7ee6ca4c5b15fa60b9c",
    "upstream_checksums_sha256": "1f5e5f804682f32119c7f86b8a838ef7319855e62fb01498e42cfd8764dd9097",
    "auth_storage_source_sha256": "7ed4e4a28faf1367fb4e35fba25f59d24c8af0ae6328a900c71a66c873ac8e9e"
  },
  "authentication": {
    "login_argv": ["auth", "login", "--hostname", "{host}"],
    "status_argv": ["auth", "status", "--hostname", "{host}"],
    "tty_required_by_glab_axi": true,
    "forbidden_flags": ["--token", "--job-token", "--stdin", "--insecure-storage", "--api-protocol", "--git-protocol", "--web", "--device"],
    "secure_default": "operating-system keyring when available",
    "upstream_plaintext_fallback": true,
    "fallback_warning": "The operating system keyring is unavailable. Storing credentials as plaintext in the configuration file.",
    "login_environment_credentials": "removed before child execution; approved token variables remain available only to headless reads",
    "glab_axi_policy": "require a real human TTY, preflight a non-secret secure-store probe, and abort on the pinned fallback warning before token acquisition"
  },
  "operations": [
    {
      "name": "board-list",
      "kind": "fixed-graphql-query-page",
      "argv": ["api", "graphql", "--method", "POST", "--hostname", "{host}", "--raw-field", "query={pinned_board_list_document}", "--raw-field", "fullPath={explicit_scope_path}", "--field", "first={bounded_page_size}"],
      "contract": "contracts/gitlab-planning/v19.3.0/queries.json",
      "input_policy": "Exactly one project/group path; only bounded first and opaque after variables; no arbitrary query or fields"
    },
    {
      "name": "board-view",
      "kind": "fixed-graphql-query-page",
      "argv": ["api", "graphql", "--method", "POST", "--hostname", "{host}", "--raw-field", "query={pinned_board_view_document}", "--raw-field", "fullPath={explicit_scope_path}", "--field", "first={bounded_page_size}", "--raw-field", "board=gid://gitlab/Board/{positive_id}"],
      "contract": "contracts/gitlab-planning/v19.3.0/queries.json",
      "input_policy": "Only board and list metadata; never select issues or create default lists"
    },
    {
      "name": "board-issues",
      "kind": "guarded-fixed-graphql-query-with-ordering-side-effects",
      "argv": ["api", "graphql", "--method", "POST", "--hostname", "{explicit_host}", "--raw-field", "query={pinned_board_issues_document}", "--raw-field", "fullPath={explicit_scope_path}", "--field", "first={bounded_page_size}", "--raw-field", "board=gid://gitlab/Board/{positive_id}", "--raw-field", "list=gid://gitlab/List/{positive_list_id}"],
      "contract": "contracts/gitlab-planning/v19.3.0/queries.json",
      "input_policy": "Requires per-invocation allow-ordering-initialization; may initialize missing positions and shift siblings beyond displayed items; no retry; receipt reports uncertain effects"
    },
    {
      "name": "work-item-fields",
      "kind": "fixed-graphql-query-object",
      "argv": ["api", "graphql", "--method", "POST", "--hostname", "{host}", "--raw-field", "query={pinned_work_item_fields_document}", "--raw-field", "fullPath={explicit_scope_path}", "--raw-field", "iid={positive_iid}"],
      "contract": "contracts/gitlab-planning/v19.3.0/queries.json",
      "input_policy": "Direct namespace IID only; visible widget types, not arbitrary custom-field definitions or values"
    },
    {
      "name": "work-item-hierarchy",
      "kind": "fixed-graphql-query-page",
      "argv": ["api", "graphql", "--method", "POST", "--hostname", "{host}", "--raw-field", "query={pinned_work_item_hierarchy_document}", "--raw-field", "fullPath={explicit_scope_path}", "--field", "first={bounded_page_size}", "--raw-field", "iid={positive_iid}"],
      "contract": "contracts/gitlab-planning/v19.3.0/queries.json",
      "input_policy": "HIERARCHY widget only; parent plus paginated authorized direct children; no recursive or issue-link equivalence"
    },
    {
      "name": "issue-list",
      "kind": "read-json-page",
      "argv": ["issue", "list", "--output", "json", "--page", "{page}", "--per-page", "{per_page}", "-R", "{repo}"],
      "optional_argv_before_page": ["--all|--closed", "--label={exact_label} (repeatable, maximum 20)", "--author={username}", "--assignee={username}", "--milestone={title}", "--order=created_at|updated_at with --sort=desc"],
      "filter_evidence": "help.txt issue list; TestPinnedOfficialGlabReadFiltersTLS: exact AND labels and milestone query, username GET resolution to author_id/assignee_id, state and ordering. Unknown/duplicate/special selectors fail before child work."
    },
    {
      "name": "issue-view",
      "kind": "read-json-object",
      "argv": ["issue", "view", "{iid}", "--output", "json", "-R", "{repo}"]
    },
    {
      "name": "issue-edit-project",
      "kind": "fixed-api-read-json-object",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}"]
    },
    {
      "name": "issue-edit-view",
      "kind": "fixed-api-read-json-object",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/issues/{iid}"]
    },
    {
      "name": "issue-edit-label-list",
      "kind": "fixed-api-read-json-page",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/labels?include_ancestor_groups=true&page={page}&per_page={per_page}"]
    },
    {
      "name": "mr-list",
      "kind": "read-json-page",
      "argv": ["mr", "list", "--output", "json", "--page", "{page}", "--per-page", "{per_page}", "-R", "{repo}"],
      "optional_argv_before_page": ["--all|--closed|--merged", "--label={exact_label} (repeatable, maximum 20)", "--author={username}", "--assignee={username}", "--source-branch={branch}", "--target-branch={branch}", "--draft|--not-draft"],
      "filter_evidence": "help.txt mr list; TestPinnedOfficialGlabReadFiltersTLS: exact source_branch/target_branch, username IDs, labels/state and wip=yes|no. Field/body selection is local and never forwarded."
    },
    {
      "name": "mr-view",
      "kind": "read-json-object",
      "argv": ["mr", "view", "{iid}", "--output", "json", "-R", "{repo}"],
      "response_normalization": {
        "canonical_source_head": "sha",
        "official_client_source_head": "diff_refs.head_sha",
        "canonical_base": "base_sha",
        "official_client_base": "diff_refs.base_sha",
        "dual_value_policy": "require-exact-match",
        "missing_or_malformed_policy": "refuse"
      }
    },
    {
      "name": "mr-diff",
      "kind": "read-text",
      "argv": ["mr", "diff", "{iid}", "--color", "never", "-R", "{repo}"]
    },
    {
      "name": "mr-checks",
      "kind": "read-json-object",
      "argv": ["ci", "get", "--merge-request", "{iid}", "--output", "json", "-R", "{repo}"]
    },
    {
      "name": "mr-discussions",
      "kind": "fixed-api-read-json-page",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/merge_requests/{iid}/discussions?page={page}&per_page={per_page}"]
    },
    {
      "name": "mr-discussions-target-project",
      "kind": "fixed-api-read-json-object",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}"]
    },
    {
      "name": "mr-discussions-source-project",
      "kind": "fixed-api-read-json-object-provider-id",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{source_project_id}"],
      "input_policy": "source_project_id must be a validated positive integer from the bound merge request"
    },
    {
      "name": "pipeline-list",
      "kind": "read-json-page",
      "argv": ["ci", "list", "--output", "json", "--page", "{page}", "--per-page", "{per_page}", "-R", "{repo}"],
      "optional_typed_argv_before_page": ["--ref", "{ref}", "--status", "{gitlab_status}", "--source", "{pipeline_source}", "--username", "{username}", "--sha", "{sha}"],
      "response_optional_additive_fields": ["iid"],
      "evidence": "ci-reads-source.go.txt; help.txt ci list"
    },
    {
      "name": "pipeline-view",
      "kind": "fixed-api-read-json-object",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/pipelines/{id}"]
    },
    {
      "name": "job-list",
      "kind": "fixed-api-read-json-page",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/pipelines/{pipeline_id}/jobs?page={page}&per_page={per_page}"],
      "optional_typed_query_suffix": "&scope%5B%5D={gitlab_status}",
      "evidence": "ci-reads-source.go.txt ListJobsOptions and ListPipelineJobs"
    },
    {
      "name": "job-view",
      "kind": "fixed-api-read-json-object",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/jobs/{id}"]
    },
    {
      "name": "job-trace",
      "kind": "fixed-api-read-text",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/jobs/{id}/trace"]
    },
    {
      "name": "release-list",
      "kind": "read-json-page",
      "argv": ["release", "list", "--output", "json", "--page", "{page}", "--per-page", "{per_page}", "-R", "{repo}"]
    },
    {
      "name": "release-view",
      "kind": "read-json-object",
      "argv": ["release", "view", "{tag}", "--output", "json", "-R", "{repo}"]
    },
    {
      "name": "repo-list",
      "kind": "read-json-page",
      "argv": ["repo", "list", "--output", "json", "--page", "{page}", "--per-page", "{per_page}"]
    },
    {
      "name": "repo-view",
      "kind": "read-json-object",
      "argv": ["repo", "view", "{repo}", "--output", "json"]
    },
    {
      "name": "label-list",
      "kind": "read-json-page",
      "argv": ["label", "list", "--output", "json", "--page", "{page}", "--per-page", "{per_page}", "-R", "{repo}"]
    },
    {
      "name": "search",
      "kind": "fixed-api-read-json-page",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "{fixed_search_endpoint}"]
    },
    {
      "name": "mr-ensure-project",
      "kind": "fixed-api-read-json-object",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}"]
    },
    {
      "name": "mr-ensure-list",
      "kind": "fixed-api-read-json-page",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/merge_requests?state=opened&source_branch={escaped_source}&target_branch={escaped_target}&page={page}&per_page={per_page}"]
    },
    {
      "name": "mr-ensure-create",
      "kind": "fixed-api-write-json-object",
      "argv": ["api", "--method", "POST", "--hostname", "{host}", "projects/{escaped_repo}/merge_requests", "--input", "{private_json_file}", "--header", "Content-Type: application/json"]
    },
    {
      "name": "mr-ensure-update",
      "kind": "fixed-api-write-json-object",
      "argv": ["api", "--method", "PUT", "--hostname", "{host}", "projects/{escaped_repo}/merge_requests/{iid}", "--input", "{private_json_file}", "--header", "Content-Type: application/json"]
    },
    {
      "name": "mr-merge-project",
      "kind": "fixed-api-read-json-object",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}"]
    },
    {
      "name": "mr-merge-view",
      "kind": "fixed-api-read-json-object",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/merge_requests/{iid}?with_merge_status_recheck=true"]
    },
    {
      "name": "mr-merge-job-list",
      "kind": "fixed-api-read-json-page",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/pipelines/{pipeline_id}/jobs?include_retried=false&page={page}&per_page={per_page}"]
    },
    {
      "name": "mr-merge-bridge-list",
      "kind": "fixed-api-read-json-page",
      "argv": ["api", "--method", "GET", "--hostname", "{host}", "projects/{escaped_repo}/pipelines/{pipeline_id}/bridges?include_retried=false&page={page}&per_page={per_page}"]
    },
    {
      "name": "mr-merge",
      "kind": "fixed-api-write-json-object-one-attempt",
      "argv": ["api", "--method", "PUT", "--hostname", "{host}", "projects/{escaped_repo}/merge_requests/{iid}/merge", "--input", "{private_json_file}", "--header", "Content-Type: application/json"]
    }
  ],
  "permanent_denials": [
    "public api passthrough",
    "unguarded or alternate-strategy merge",
    "approve",
    "comment, note, reply, or discussion resolution mutation",
    "issue field or label mutation and issue creation",
    "merge request label or edit mutation",
    "label-resource mutation",
    "close, reopen, or delete",
    "repository mutation",
    "release mutation",
    "pipeline trigger, retry, cancel, or delete",
    "secret or variable operations (require the separate explicit product-native contract)"
  ]
}
