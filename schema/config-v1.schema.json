{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/config-v1.schema.json",
  "title": "glab-axi/config-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hosts"],
  "properties": {
    "schema": {"const": "glab-axi/config-v1"},
    "hosts": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z0-9.-]+(?::[0-9]+)?$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["git_hosts", "api_base", "web_base"],
        "properties": {
          "git_hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "maxLength": 253}
          },
          "api_base": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://.+/api/v4/?$",
            "maxLength": 2048
          },
          "web_base": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "ca_bundle": {"type": "string", "maxLength": 4096},
          "proxy_disabled": {"type": "boolean"}
        }
      }
    }
  }
}
