{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/ux-v1/resource-delete.schema.json",
  "title": "glab-axi/ux-v1 exact resource deletion data or bounded failure receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["deletion"],
  "properties": {
    "deletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "resource", "scope", "url", "actor_id", "expected", "delete_attempted", "acknowledged", "postcondition", "concurrency", "intended_effects"],
      "properties": {
        "action": {"enum": ["deleted", "not_applied", "rejected", "ambiguous"]},
        "resource": {"enum": ["issue", "pipeline", "release", "snippet"]},
        "scope": {"enum": ["project", "personal"]},
        "url": {"type": "string", "format": "uri", "maxLength": 2048},
        "project_id": {"type": "integer", "minimum": 1},
        "id": {"type": "integer", "minimum": 1},
        "iid": {"type": "integer", "minimum": 1},
        "tag": {"type": "string", "minLength": 1, "maxLength": 512},
        "actor_id": {"type": "integer", "minimum": 1},
        "expected": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "state": {"enum": ["opened", "closed"]},
            "updated_at": {"type": "string", "format": "date-time", "maxLength": 64},
            "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
            "sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
            "ref": {"type": "string", "minLength": 1, "maxLength": 1024},
            "status": {"enum": ["created", "waiting_for_resource", "preparing", "pending", "running", "success", "failed", "canceled", "skipped", "manual", "scheduled"]},
            "author_id": {"type": "integer", "minimum": 1}
          }
        },
        "delete_attempted": {"type": "boolean"},
        "delete_status": {"type": "integer", "minimum": 100, "maximum": 599},
        "acknowledged": {"type": "boolean"},
        "postcondition": {"enum": ["not_checked", "not_found", "present", "unverified"]},
        "tag_postcondition": {"enum": ["unchanged", "unverified"]},
        "concurrency": {"const": "best_effort_non_atomic"},
        "child_cancellation": {
          "type": "object", "additionalProperties": false,
          "required": ["acknowledged", "outcome"],
          "properties": {
            "acknowledged": {"const": true},
            "outcome": {"enum": ["not_attempted", "unverified"]}
          }
        },
        "intended_effects": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["delete_issue_not_close", "delete_related_builds_logs_artifacts_triggers", "expire_pipeline_caches", "do_not_recursively_delete_child_pipelines", "may_cancel_surviving_child_pipelines", "delete_release_metadata_only", "retain_tag", "delete_selected_snippet_and_provider_managed_content"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"scope": {"const": "project"}}},
          "then": {"required": ["project_id"]},
          "else": {"properties": {"resource": {"const": "snippet"}}, "not": {"required": ["project_id"]}}
        },
        {
          "if": {"properties": {"resource": {"const": "release"}}},
          "then": {"required": ["tag", "tag_postcondition"], "properties": {"expected": {"required": ["sha", "created_at"]}}},
          "else": {"required": ["id"], "not": {"anyOf": [{"required": ["tag"]}, {"required": ["tag_postcondition"]}]}}
        },
        {
          "if": {"properties": {"resource": {"const": "issue"}}},
          "then": {"required": ["iid"], "properties": {"expected": {"required": ["state", "updated_at"]}}}
        },
        {
          "if": {"properties": {"resource": {"const": "pipeline"}}},
          "then": {
            "required": ["child_cancellation"],
            "properties": {
              "expected": {"required": ["sha", "ref", "status", "updated_at"]},
              "intended_effects": {"contains": {"const": "may_cancel_surviving_child_pipelines"}}
            },
            "if": {"properties": {"delete_attempted": {"const": false}}},
            "then": {"properties": {"child_cancellation": {"properties": {"outcome": {"const": "not_attempted"}}}}},
            "else": {"properties": {"child_cancellation": {"properties": {"outcome": {"const": "unverified"}}}}}
          },
          "else": {"not": {"required": ["child_cancellation"]}}
        },
        {
          "if": {"properties": {"resource": {"const": "snippet"}}},
          "then": {"properties": {"expected": {"required": ["author_id", "updated_at"]}}}
        },
        {
          "if": {"properties": {"action": {"const": "not_applied"}}},
          "then": {"properties": {"delete_attempted": {"const": false}, "acknowledged": {"const": false}, "postcondition": {"const": "not_checked"}}, "not": {"required": ["delete_status"]}},
          "else": {"properties": {"delete_attempted": {"const": true}}}
        },
        {
          "if": {"properties": {"action": {"const": "rejected"}}},
          "then": {"required": ["delete_status"], "properties": {"acknowledged": {"const": false}, "postcondition": {"const": "not_checked"}, "delete_status": {"enum": [400, 401, 403, 404, 405, 409, 412, 422, 429]}}}
        },
        {
          "if": {"properties": {"action": {"const": "deleted"}}},
          "then": {
            "required": ["delete_status"],
            "properties": {"acknowledged": {"const": true}, "postcondition": {"const": "not_found"}},
            "if": {"properties": {"resource": {"const": "release"}}},
            "then": {"properties": {"delete_status": {"const": 200}, "tag_postcondition": {"const": "unchanged"}}},
            "else": {"properties": {"delete_status": {"const": 204}}}
          }
        }
      ]
    }
  }
}
