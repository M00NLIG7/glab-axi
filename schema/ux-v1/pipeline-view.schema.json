{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/ux-v1/pipeline-view.schema.json",
  "title": "glab-axi/ux-v1 pipeline-view data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pipeline"
  ],
  "properties": {
    "pipeline": {
      "$ref": "resources.schema.json#/$defs/pipeline"
    },
    "jobs": {"type": "array", "maxItems": 1000, "items": {"$ref": "resources.schema.json#/$defs/job"}},
    "traces": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["job_id", "trace", "truncated"],
        "properties": {
          "job_id": {"type": "integer", "minimum": 1},
          "trace": {"type": "string", "maxLength": 262168},
          "truncated": {"type": "boolean"}
        }
      }
    }
  }
}
