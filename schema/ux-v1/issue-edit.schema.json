{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/ux-v1/issue-edit.schema.json",
  "title": "glab-axi/ux-v1 best-effort issue-edit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["edit"],
  "$defs": {
    "text_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 0, "maximum": 131072},
        "value": {"type": "string", "maxLength": 4096},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "oneOf": [
        {"required": ["value"], "not": {"required": ["sha256"]}},
        {"required": ["sha256"], "not": {"required": ["value"]}}
      ]
    },
    "text_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after"],
      "properties": {
        "before": {"$ref": "#/$defs/text_evidence"},
        "after": {"$ref": "#/$defs/text_evidence"}
      }
    },
    "label_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "label_set_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "bytes"],
      "properties": {
        "count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "bytes": {"type": "integer", "minimum": 2, "maximum": 8388608},
        "values": {
          "type": "array",
          "maxItems": 100,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "oneOf": [
        {"required": ["values"], "not": {"required": ["sha256"]}},
        {"required": ["sha256"], "not": {"required": ["values"]}}
      ]
    }
  },
  "properties": {
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "outcome",
        "dry_run",
        "identity",
        "expected",
        "changed_fields",
        "changes",
        "concurrency",
        "warning"
      ],
      "properties": {
        "action": {"enum": ["preview", "unchanged", "updated", "reconciled_update", "ambiguous"]},
        "outcome": {"enum": ["not_applied", "observed_applied", "unknown"]},
        "dry_run": {"type": "boolean"},
        "concurrency": {"const": "best_effort"},
        "warning": {"const": "GitLab cannot enforce an atomic expected revision or numeric label identity on this write. Concurrent edits or label renames between checks and PUT can race; receipts describe observed state, not exclusive authorship."},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host", "project_id", "project_full_path", "project_web_url", "issue_id", "iid", "web_url"],
          "properties": {
            "host": {"type": "string", "minLength": 1, "maxLength": 253},
            "project_id": {"type": "integer", "minimum": 1},
            "project_full_path": {"type": "string", "minLength": 3, "maxLength": 1024},
            "project_web_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "issue_id": {"type": "integer", "minimum": 1},
            "iid": {"type": "integer", "minimum": 1},
            "web_url": {"type": "string", "format": "uri", "pattern": "^https://"}
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web_url", "state", "updated_at"],
          "properties": {
            "web_url": {"type": "string", "format": "uri", "pattern": "^https://"},
            "state": {"enum": ["opened", "closed"]},
            "updated_at": {"type": "string", "format": "date-time"}
          }
        },
        "changed_fields": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["title", "description", "labels"]}
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "title": {"$ref": "#/$defs/text_change"},
            "description": {"$ref": "#/$defs/text_change"},
            "labels": {
              "type": "object",
              "additionalProperties": false,
              "required": ["add", "remove", "before", "after"],
              "properties": {
                "add": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/label_identity"}},
                "remove": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/label_identity"}},
                "before": {"$ref": "#/$defs/label_set_evidence"},
                "after": {"$ref": "#/$defs/label_set_evidence"}
              }
            }
          }
        },
        "resulting_updated_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {
          "if": {"properties": {"action": {"const": "ambiguous"}}, "required": ["action"]},
          "then": {"not": {"required": ["resulting_updated_at"]}, "properties": {"outcome": {"const": "unknown"}}},
          "else": {"required": ["resulting_updated_at"]}
        },
        {
          "if": {"properties": {"action": {"enum": ["updated", "reconciled_update"]}}},
          "then": {"properties": {"outcome": {"const": "observed_applied"}, "changed_fields": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"action": {"enum": ["preview", "unchanged"]}}},
          "then": {"properties": {"outcome": {"const": "not_applied"}}}
        },
        {
          "if": {"properties": {"action": {"const": "preview"}}, "required": ["action"]},
          "then": {"properties": {"dry_run": {"const": true}}},
          "else": {"properties": {"dry_run": {"const": false}}}
        }
      ]
    }
  }
}
