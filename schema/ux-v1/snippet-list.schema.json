{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/ux-v1/snippet-list.schema.json",
  "title": "glab-axi/ux-v1 snippet-list data",
  "type": "object",
  "additionalProperties": false,
  "required": ["snippets", "scope", "authenticated_user"],
  "properties": {
    "snippets": {"type": "array", "maxItems": 1000, "items": {"$ref": "snippet-view.schema.json#/$defs/snippet"}},
    "scope": {"enum": ["personal", "project"]},
    "authenticated_user": {"$ref": "snippet-view.schema.json#/$defs/user"}
  }
}
