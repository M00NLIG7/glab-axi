{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/ux-v1/mr-discussions.schema.json",
  "title": "glab-axi/ux-v1 mr-discussions data",
  "type": "object",
  "additionalProperties": false,
  "required": ["mr", "discussions"],
  "properties": {
    "mr": {"$ref": "#/$defs/mr_identity"},
    "discussions": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/discussion"}
    }
  },
  "$defs": {
    "mr_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "iid", "project_id", "web_url"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "iid": {"type": "integer", "minimum": 1},
        "project_id": {"type": "integer", "minimum": 1},
        "web_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "username"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "username": {"type": "string", "minLength": 1, "maxLength": 256},
        "name": {"type": "string", "maxLength": 256}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "maxLength": 128},
        "old_line": {"type": "integer", "minimum": 1},
        "new_line": {"type": "integer", "minimum": 1},
        "line_code": {"type": "string", "maxLength": 256}
      },
      "anyOf": [
        {"required": ["old_line"]},
        {"required": ["new_line"]}
      ]
    },
    "line_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/line"},
        "end": {"$ref": "#/$defs/line"}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_type"],
      "properties": {
        "position_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "start_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "old_path": {"type": "string", "maxLength": 1024},
        "new_path": {"type": "string", "maxLength": 1024},
        "old_line": {"type": "integer", "minimum": 1},
        "new_line": {"type": "integer", "minimum": 1},
        "line_range": {"$ref": "#/$defs/line_range"}
      },
      "anyOf": [
        {"required": ["old_path"]},
        {"required": ["new_path"]}
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "author", "created_at", "updated_at", "body", "system", "resolvable", "resolved"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "type": {"type": "string", "maxLength": 128},
        "author": {"$ref": "#/$defs/user"},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"},
        "body": {"type": "string", "minLength": 1, "maxLength": 131072},
        "system": {"type": "boolean"},
        "resolvable": {"type": "boolean"},
        "resolved": {"type": "boolean"},
        "resolved_by": {"$ref": "#/$defs/user"},
        "resolved_at": {"type": "string", "format": "date-time"},
        "position": {"$ref": "#/$defs/position"}
      }
    },
    "discussion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "individual_note", "notes"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "individual_note": {"type": "boolean"},
        "notes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/note"}
        }
      }
    }
  }
}
