{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/ux-v1/repo-view.schema.json",
  "title": "glab-axi/ux-v1 repo-view data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository"
  ],
  "properties": {
    "repository": {
      "$ref": "resources.schema.json#/$defs/repository"
    },
    "admin_snapshot": {"$ref": "repo-admin.schema.json#/$defs/project"},
    "import_status": {"enum": ["none", "scheduled", "started", "finished", "failed", "unknown"]},
    "forked_from_project": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path_with_namespace", "web_url"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "path_with_namespace": {"type": "string", "maxLength": 1024},
        "web_url": {"type": "string", "format": "uri", "maxLength": 2048}
      }
    }
  }
}
