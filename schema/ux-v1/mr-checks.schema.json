{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/ux-v1/mr-checks.schema.json",
  "title": "glab-axi/ux-v1 mr-checks data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mr_iid",
    "pipeline",
    "jobs"
  ],
  "properties": {
    "mr_iid": {
      "type": "integer",
      "minimum": 1
    },
    "pipeline": {
      "$ref": "resources.schema.json#/$defs/pipeline"
    },
    "jobs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "resources.schema.json#/$defs/job"
      }
    }
  }
}
