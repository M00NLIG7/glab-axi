{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/ux-v1/issue-discussions.schema.json",
  "title": "glab-axi/ux-v1 issue-discussions data",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue", "discussions"],
  "properties": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "iid", "project_id", "project", "web_url", "updated_at"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "iid": {"type": "integer", "minimum": 1},
        "project_id": {"type": "integer", "minimum": 1},
        "project": {"$ref": "mr-discussions.schema.json#/$defs/project_identity"},
        "web_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "discussions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "project_id", "issue_id", "issue_iid", "individual_note", "resolvable", "resolved", "resolution_state", "notes"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 256},
          "project_id": {"type": "integer", "minimum": 1},
          "issue_id": {"type": "integer", "minimum": 1},
          "issue_iid": {"type": "integer", "minimum": 1},
          "individual_note": {"type": "boolean"},
          "resolvable": {"type": "boolean"},
          "resolved": {"type": "boolean"},
          "resolution_state": {"enum": ["not_resolvable", "resolved", "unresolved"]},
          "notes": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "mr-discussions.schema.json#/$defs/note"}}
        }
      }
    }
  }
}
