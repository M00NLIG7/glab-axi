{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/ux-v1/dashboard.schema.json",
  "title": "glab-axi/ux-v1 dashboard data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repository",
    "open_issues",
    "open_mrs",
    "latest_pipelines"
  ],
  "properties": {
    "repository": {
      "$ref": "resources.schema.json#/$defs/repository"
    },
    "open_issues": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "resources.schema.json#/$defs/issue"
      }
    },
    "open_mrs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "resources.schema.json#/$defs/mr"
      }
    },
    "latest_pipelines": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "resources.schema.json#/$defs/pipeline"
      }
    }
  }
}
