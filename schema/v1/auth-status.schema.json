{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/v1/auth-status.schema.json",
  "title": "glab-axi/v1 auth-status data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authenticated",
    "host",
    "project"
  ],
  "properties": {
    "authenticated": {
      "const": true
    },
    "host": {
      "type": "string",
      "maxLength": 4096
    },
    "project": {
      "type": "string",
      "maxLength": 4096
    }
  }
}
