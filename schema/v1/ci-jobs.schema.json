{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/v1/ci-jobs.schema.json",
  "title": "glab-axi/v1 ci-jobs data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jobs"
  ],
  "properties": {
    "jobs": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "stage",
          "status"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 4096
          },
          "stage": {
            "type": "string",
            "maxLength": 4096
          },
          "status": {
            "type": "string",
            "maxLength": 4096
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "raw_status": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    }
  }
}
