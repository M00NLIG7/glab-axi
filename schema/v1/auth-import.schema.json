{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glab-axi.invalid/schema/v1/auth-import.schema.json",
  "title": "glab-axi/v1 auth-import data",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "imported",
    "host",
    "storage"
  ],
  "properties": {
    "imported": {
      "const": true
    },
    "host": {
      "type": "string",
      "maxLength": 4096
    },
    "storage": {
      "const": "os_keyring"
    }
  }
}
